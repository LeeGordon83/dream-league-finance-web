<div class="card season-shell mb-3">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
      <div>
        <h4 class="mb-1">Current Season</h4>
        <p class="text-muted mb-0">Your season is active and tracking weekly activity.</p>
      </div>
      <span class="badge badge-success season-status">Active</span>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <div class="season-stat">
          <p class="season-stat-label">Week Start Date</p>
          <p class="season-stat-value">{{ season.start | formatDate }}</p>
        </div>
      </div>

      <div class="col-md-4 mb-3">
        <div class="season-stat">
          <p class="season-stat-label">Number of Weeks</p>
          <p class="season-stat-value">{{ season.weeks|length }}</p>
        </div>
      </div>

      <div class="col-md-4 mb-3">
        <div class="season-stat">
          <p class="season-stat-label">Number of Managers</p>
          <p class="season-stat-value">{{ season.managers }}</p>
        </div>
      </div>
    </div>

    <button type="button" class="btn btn-outline-secondary" disabled>End Season (coming soon)</button>
  </div>
</div>

