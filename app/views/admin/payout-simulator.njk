{% extends '_layout.njk' %}

{% block content %}

<div class="simulator-page">
  <div class="mb-4">
    <h2 class="mb-1">Payout Simulator</h2>
    <p class="text-muted mb-0">Choose a manager and season outcome to estimate payout and projected net position.</p>
  </div>

  {% if error %}
    <div class="alert alert-danger">{{ error.message }}</div>
  {% endif %}

  <div class="card simulator-shell mb-4">
    <div class="card-body p-4">
      <form method="POST" action="/payout-simulator">
        <input type="hidden" name="crumb" value="{{ crumb }}" />

        <div class="form-row">
          <div class="col-lg-6 mb-3 mb-lg-0">
            <div class="simulator-panel h-100">
              <p class="simulator-panel-title">Manager and Position</p>

              <div class="form-group">
                <label for="managerId">Manager</label>
                <select id="managerId" name="managerId" class="form-control" required>
                  {% for manager in managers %}
                    {% set id = manager.managerId or manager.id %}
                    <option value="{{ id }}" {% if values.managerId == id %}selected{% endif %}>{{ manager.name }}</option>
                  {% endfor %}
                </select>
              </div>

              <div class="form-group mb-0">
                <label for="leaguePosition">League Finish</label>
                <select id="leaguePosition" name="leaguePosition" class="form-control" required>
                  {% for position in positions %}
                    <option value="{{ position }}" {% if values.leaguePosition == position %}selected{% endif %}>{{ position }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="simulator-panel h-100">
              <p class="simulator-panel-title">Competition Outcomes</p>

              <div class="form-group">
                <label for="cupResult">Cup Result</label>
                <select id="cupResult" name="cupResult" class="form-control" required>
                  <option value="none" {% if values.cupResult == 'none' %}selected{% endif %}>No cup payout</option>
                  <option value="win" {% if values.cupResult == 'win' %}selected{% endif %}>Cup winner</option>
                  <option value="runner-up" {% if values.cupResult == 'runner-up' %}selected{% endif %}>Cup runner-up</option>
                </select>
              </div>

              <div class="form-group mb-0">
                <label for="leagueCupResult">League Cup Result</label>
                <select id="leagueCupResult" name="leagueCupResult" class="form-control" required>
                  <option value="none" {% if values.leagueCupResult == 'none' %}selected{% endif %}>No league cup payout</option>
                  <option value="win" {% if values.leagueCupResult == 'win' %}selected{% endif %}>League cup winner</option>
                  <option value="runner-up" {% if values.leagueCupResult == 'runner-up' %}selected{% endif %}>League cup runner-up</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class="simulator-toggle mt-3 mb-3">
          <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="winsJackpot" name="winsJackpot" {% if values.winsJackpot %}checked{% endif %}>
            <label class="form-check-label" for="winsJackpot">Manager wins current jackpot</label>
          </div>
        </div>

        <div class="d-flex align-items-center justify-content-between flex-wrap">
          <p class="text-muted mb-2 mb-md-0">Use this to model one manager's end-of-season payout scenario.</p>
          <div>
            <button type="submit" class="btn btn-primary px-4">Calculate Payout</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  {% if result %}
    <h4 class="mb-3">{{ result.managerName }} Scenario Result</h4>

    <div class="row">
      <div class="col-md-6 mb-3">
        <div class="card h-100">
          <div class="card-header">To Date</div>
          <div class="card-body">
            <p class="mb-1"><strong>Weekly Total:</strong> £{{ result.toDate.weeklyTotal.toFixed(2) }}</p>
            <p class="mb-1"><strong>Fivers Total:</strong> £{{ result.toDate.fiversTotal.toFixed(2) }}</p>
            <p class="mb-1"><strong>Jackpot Total:</strong> £{{ result.toDate.jackpotTotal.toFixed(2) }}</p>
            <p class="mb-1"><strong>Paid In (recorded):</strong> £{{ result.toDate.paidIn.toFixed(2) }}</p>
            <p class="mb-1"><strong>Fees Owed To Date:</strong> £{{ result.toDate.feesOwedToDate.toFixed(2) }}</p>
            <p class="mb-1"><strong>Outstanding Contributions:</strong> £{{ result.toDate.outstandingContributions.toFixed(2) }}</p>
            <p class="mb-0"><strong>Net To Date (winnings - owed):</strong> £{{ result.toDate.netToDate.toFixed(2) }}</p>
          </div>
        </div>
      </div>

      <div class="col-md-6 mb-3">
        <div class="card h-100">
          <div class="card-header">Scenario Payout</div>
          <div class="card-body">
            <p class="mb-1"><strong>League ({{ result.leaguePrizeType }}):</strong> £{{ result.scenario.leaguePrize.toFixed(2) }}</p>
            <p class="mb-1"><strong>Cup:</strong> £{{ result.scenario.cupPrize.toFixed(2) }}</p>
            <p class="mb-1"><strong>League Cup:</strong> £{{ result.scenario.leagueCupPrize.toFixed(2) }}</p>
            <p class="mb-1"><strong>Jackpot:</strong> £{{ result.scenario.jackpotPrize.toFixed(2) }}</p>
            <p class="mb-0"><strong>Total Scenario Payout:</strong> £{{ result.scenario.scenarioPayout.toFixed(2) }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="alert alert-info mb-4">
      <strong>Projected Total Winnings:</strong> £{{ result.projected.projectedTotalWinnings.toFixed(2) }}
      <br />
      <strong>Projected Net Position (winnings - fees owed):</strong> £{{ result.projected.projectedNetPosition.toFixed(2) }}
    </div>
  {% endif %}
</div>

{% endblock %}
